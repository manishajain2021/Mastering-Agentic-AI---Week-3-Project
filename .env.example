# Generate a random service token for n8n. The local demo workspace needs no token.
# Never commit .env.
SERVICE_TOKEN=replace-with-n8n-service-token
PORT=8780
# Current HTTPS tunnel origin; checked before dispatching an agent run.
SERVICE_PUBLIC_URL=
# Optional: published Week 2 research endpoint. Only a fixed public question is sent.
WEEK2_ASK_URL=https://manishavgjain2021.app.n8n.cloud/webhook/aml-regulatory-ask
# Used only to dispatch agent runs; leave empty for manual n8n test-webhook runs.
N8N_RUN_URL=
N8N_RUN_KEY=
# Set to verified current model prices to enable USD estimates; values are per 1M tokens.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
MAX_CASE_USD=1
