      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b=$input.first().json.body??$input.first().json;if(!/^CASE-[a-f0-9-]{36}$/.test(b.case_id))throw Error('Invalid case ID');return [{json:{case_id:b.case_id}}];"
      }
    },
    {
      "id": "51b61978-caea-4308-ae8c-eb2583bda2f3",
