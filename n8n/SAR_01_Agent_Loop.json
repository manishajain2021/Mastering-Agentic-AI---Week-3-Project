      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://REPLACE-WITH-YOUR-CASE-SERVICE/internal/cases/{{ $json.case_id || $json.id }}/context",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "d30c6d17-1880-4c89-a2c8-4dc38f26f359",
