        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "7cebefc2-0477-4959-839f-2d96377b8632",
      "name": "Bind Decision To Case",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const ctx=$('Load Context').item.json;return [{json:{case_id:ctx.case_id,version:ctx.version,completion:$input.first().json}}];"
      }
    },
    {
      "id": "dd3b106f-6fe1-4030-aaa6-8540f0c8ef2a",
